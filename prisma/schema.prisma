generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// ENUMS
// ---------------------------------------------------------

// ---------------------------------------------------------
// MODELS
// ---------------------------------------------------------

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  mobile        String?
  password_hash String
  role          String
  status        String    @default("ACTIVE")
  last_login_at DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
}

model Customer {
  id            String   @id @default(uuid())
  customer_code String   @unique
  full_name     String
  mobile        String   @unique
  email         String?
  profile_image String?
  address       String?
  city          String?
  state         String?
  pincode       String?
  status        String   @default("ACTIVE")
  otp_verified  Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Relationships
  qr_codes           QrCode[]
  vehicles           Vehicle[]
  emergency_contacts EmergencyContact[]
  products           CustomerProduct[]
}

model QrCode {
  id             String    @id @default(uuid())
  qr_serial      String    @unique
  qr_token       String    @unique
  qr_url         String
  customer_id    String?
  product_type   String
  status         String    @default("AVAILABLE")
  batch_id       String?
  generated_at   DateTime  @default(now())
  assigned_at    DateTime?
  activated_at   DateTime?
  blocked_at     DateTime?
  blocked_reason String?
  created_by     String?
  updated_at     DateTime  @updatedAt

  // Relationships
  customer Customer? @relation(fields: [customer_id], references: [id])
  batch    QrBatch?  @relation(fields: [batch_id], references: [id])
}

model QrBatch {
  id              String   @id @default(uuid())
  batch_code      String   @unique
  product_type    String
  quantity        Int
  generated_count Int      @default(0)
  pdf_path        String?
  status          String   @default("PENDING")
  created_by      String?
  created_at      DateTime @default(now())

  // Relationships
  qr_codes QrCode[]
}

model Vehicle {
  id                  String   @id @default(uuid())
  customer_id         String
  vehicle_type        String
  registration_number String   @unique
  make                String?
  model               String?
  variant             String?
  color               String?
  manufacturing_year  Int?
  fuel_type           String?
  vehicle_image       String?
  status              String   @default("ACTIVE")
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  // Relationships
  customer Customer @relation(fields: [customer_id], references: [id])
}

model EmergencyContact {
  id           String   @id @default(uuid())
  customer_id  String
  name         String
  relationship String
  mobile       String
  priority     Int      @default(1)
  is_primary   Boolean  @default(false)
  status       String   @default("ACTIVE")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  // Relationships
  customer Customer @relation(fields: [customer_id], references: [id])
}

model VehicleRegistrationHistory {
  id           String   @id @default(uuid())
  vehicle_id   String
  customer_id  String
  action       String
  old_data     String?
  new_data     String?
  performed_by String?
  created_at   DateTime @default(now())
}

model QrAuditLog {
  id           String   @id @default(uuid())
  qr_id        String
  action       String
  performed_by String?
  old_status   String?
  new_status   String?
  metadata     String?
  created_at   DateTime @default(now())
}

model OtpVerification {
  id          String    @id @default(uuid())
  mobile      String
  otp_hash    String
  purpose     String
  attempts    Int       @default(0)
  expires_at  DateTime
  verified_at DateTime?
  created_at  DateTime  @default(now())
}

model CustomerProduct {
  id              String   @id @default(uuid())
  customer_id     String
  qr_id           String
  activation_date DateTime
  expiry_date     DateTime
  validity_years  Int      @default(10)
  status          String
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Relationships
  customer Customer @relation(fields: [customer_id], references: [id])
}

