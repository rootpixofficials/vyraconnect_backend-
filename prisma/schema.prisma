generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// ENUMS
// ---------------------------------------------------------

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  OPERATOR
  SUPPORT
  VIEWER
}

enum AdminStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  DELETED
}

enum ProductType {
  BIKE
  CAR
  MIXED
}

enum QRStatus {
  AVAILABLE
  RESERVED
  ASSIGNED
  ACTIVE
  BLOCKED
  REPLACED
  EXPIRED
}

enum BatchStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
}

enum VehicleType {
  BIKE
  CAR
  OTHER
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  SOLD
  TRANSFERRED
  BLOCKED
}

enum EmergencyContactStatus {
  ACTIVE
  INACTIVE
}

// ---------------------------------------------------------
// MODELS
// ---------------------------------------------------------

model Admin {
  id            String      @id @default(uuid())
  name          String      @db.VarChar(150)
  email         String      @unique @db.VarChar(255)
  mobile        String?     @db.VarChar(20)
  password_hash String
  role          AdminRole
  status        AdminStatus @default(ACTIVE)
  last_login_at DateTime?
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt
}

model Customer {
  id            String         @id @default(uuid())
  customer_code String         @unique @db.VarChar(50)
  full_name     String         @db.VarChar(150)
  mobile        String         @unique @db.VarChar(20)
  email         String?        @db.VarChar(255)
  profile_image String?        @db.Text
  address       String?        @db.Text
  city          String?        @db.VarChar(100)
  state         String?        @db.VarChar(100)
  pincode       String?        @db.VarChar(20)
  status        CustomerStatus @default(ACTIVE)
  otp_verified  Boolean        @default(false)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  // Relationships
  qr_codes           QrCode[]
  vehicles           Vehicle[]
  emergency_contacts EmergencyContact[]
  products           CustomerProduct[]
}

model QrCode {
  id             String      @id @default(uuid())
  qr_serial      String      @unique @db.VarChar(50)
  qr_token       String      @unique @db.VarChar(100)
  qr_url         String      @db.Text
  customer_id    String?
  product_type   ProductType
  status         QRStatus    @default(AVAILABLE)
  batch_id       String?
  generated_at   DateTime    @default(now())
  assigned_at    DateTime?
  activated_at   DateTime?
  blocked_at     DateTime?
  blocked_reason String?     @db.Text
  created_by     String?
  updated_at     DateTime    @updatedAt

  // Relationships
  customer Customer? @relation(fields: [customer_id], references: [id])
  batch    QrBatch?  @relation(fields: [batch_id], references: [id])
}

model QrBatch {
  id              String      @id @default(uuid())
  batch_code      String      @unique @db.VarChar(50)
  product_type    ProductType
  quantity        Int
  generated_count Int         @default(0)
  pdf_path        String?     @db.Text
  status          BatchStatus @default(PENDING)
  created_by      String?
  created_at      DateTime    @default(now())

  // Relationships
  qr_codes QrCode[]
}

model Vehicle {
  id                  String        @id @default(uuid())
  customer_id         String
  vehicle_type        VehicleType
  registration_number String        @unique @db.VarChar(50)
  make                String?       @db.VarChar(100)
  model               String?       @db.VarChar(100)
  variant             String?       @db.VarChar(100)
  color               String?       @db.VarChar(50)
  manufacturing_year  Int?
  fuel_type           String?       @db.VarChar(50)
  vehicle_image       String?       @db.Text
  status              VehicleStatus @default(ACTIVE)
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt

  // Relationships
  customer Customer @relation(fields: [customer_id], references: [id])
}

model EmergencyContact {
  id           String                 @id @default(uuid())
  customer_id  String
  name         String                 @db.VarChar(150)
  relationship String                 @db.VarChar(100)
  mobile       String                 @db.VarChar(20)
  priority     Int                    @default(1)
  is_primary   Boolean                @default(false)
  status       EmergencyContactStatus @default(ACTIVE)
  created_at   DateTime               @default(now())
  updated_at   DateTime               @updatedAt

  // Relationships
  customer Customer @relation(fields: [customer_id], references: [id])
}

model VehicleRegistrationHistory {
  id           String   @id @default(uuid())
  vehicle_id   String
  customer_id  String
  action       String   @db.VarChar(50)
  old_data     Json?    @db.Json
  new_data     Json?    @db.Json
  performed_by String?
  created_at   DateTime @default(now())
}

model QrAuditLog {
  id           String   @id @default(uuid())
  qr_id        String
  action       String   @db.VarChar(50)
  performed_by String?
  old_status   String?  @db.VarChar(30)
  new_status   String?  @db.VarChar(30)
  metadata     Json?    @db.Json
  created_at   DateTime @default(now())
}

model OtpVerification {
  id          String    @id @default(uuid())
  mobile      String    @db.VarChar(20)
  otp_hash    String    @db.Text
  purpose     String    @db.VarChar(50)
  attempts    Int       @default(0)
  expires_at  DateTime
  verified_at DateTime?
  created_at  DateTime  @default(now())
}

model CustomerProduct {
  id              String   @id @default(uuid())
  customer_id     String
  qr_id           String
  activation_date DateTime @db.Date
  expiry_date     DateTime @db.Date
  validity_years  Int      @default(10)
  status          String   @db.VarChar(50)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Relationships
  customer Customer @relation(fields: [customer_id], references: [id])
}
